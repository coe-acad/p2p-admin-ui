# Backend API base URLs (local docker-compose defaults)
VITE_BAP_URL=http://localhost:8001
VITE_BACKEND_URL=http://localhost:3002
VITE_PAYMENT_URL=http://localhost:8003

# Firebase web config (Project Settings → General → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to disable Firebase app-verification (lets test phones bypass
# reCAPTCHA). Use ONLY in local dev — never in prod.
VITE_DISABLE_PHONE_APP_VERIFICATION_FOR_TESTING=true
